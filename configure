#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
readonly script_dir
# shellcheck source=lib/config.sh
source "${script_dir}/lib/config.sh"

current_reference="$(proteus_github_reference)"
current_signing_reference="$(proteus_signing_reference)"

printf 'GitHub token 1Password secret reference (e.g. op://vault/item/entry)%s: ' \
  "${current_reference:+ [$current_reference]}"
IFS= read -r reference || true
reference="${reference:-$current_reference}"

if [[ -z "$reference" ]]; then
  printf 'A GitHub token 1Password secret reference is required.\n' >&2
  exit 1
fi

printf 'Git signing key 1Password secret reference (e.g. op://vault/item/private key)%s: ' \
  "${current_signing_reference:+ [$current_signing_reference]}"
IFS= read -r signing_reference
signing_reference="${signing_reference:-$current_signing_reference}"

if [[ -z "$signing_reference" ]]; then
  printf 'A Git signing key 1Password secret reference is required.\n' >&2
  exit 1
fi

current_login_url="$(proteus_salesforce_login_url)"

printf 'Salesforce login URL [%s]: ' "$current_login_url"
IFS= read -r login_url || true
login_url="${login_url:-$current_login_url}"
# Accept a pasted trailing slash; the saved URL has no path.
login_url="${login_url%/}"

if ! proteus_valid_salesforce_login_url "$login_url"; then
  printf 'The Salesforce login URL must be an https:// salesforce.com address with no path, such as %s or https://example.my.salesforce.com.\n' \
    "$proteus_default_salesforce_login_url" >&2
  exit 1
fi

current_aws_enabled="$(proteus_config_value proteus_aws_enabled)"
printf 'Enable AWS Credential Enrollment? [true/false; %s]: ' "${current_aws_enabled:-false}"
IFS= read -r aws_enabled || true
aws_enabled="${aws_enabled:-${current_aws_enabled:-false}}"
if [[ "$aws_enabled" != true && "$aws_enabled" != false ]]; then
  printf 'AWS enabled must be true or false.\n' >&2
  exit 1
fi
aws_pairs=(proteus_aws_enabled "$aws_enabled")
aws_values=()
if [[ "$aws_enabled" == true ]]; then
  for key in "${proteus_aws_keys[@]}"; do
    current="$(proteus_config_value "$key")"
    printf '%s [%s]: ' "$key" "$current"
    IFS= read -r value || true
    value="${value:-$current}"
    aws_values+=("$value")
    aws_pairs+=("$key" "$value")
  done
  if ! proteus_valid_aws_config "${aws_values[@]}"; then
    printf 'AWS configuration must be complete, with matching account/region ARNs and distinct op:// workload references.\n' >&2
    exit 1
  fi
fi

config_file="$(proteus_save_config "$reference" "$login_url" "$signing_reference" "${aws_pairs[@]}")"

printf 'Saved the credential sources and non-secret configuration to %s.\n' "$config_file"
