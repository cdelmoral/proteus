#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
readonly script_dir
# shellcheck source=lib/config.sh
source "${script_dir}/lib/config.sh"

usage() {
  printf 'Usage: %s {github|claude|t3|salesforce} [instance-name]\n' "${0##*/}" >&2
}

if [[ $# -lt 1 || $# -gt 2 ||
  ( "$1" != github && "$1" != claude && "$1" != t3 && "$1" != salesforce ) ||
  ( $# -eq 2 && ( -z "$2" || "$2" == -* ) ) ]]; then
  usage
  exit 2
fi
readonly tool="$1"
readonly instance="${2:-proteus}"

if [[ "$tool" == github ]]; then
  if ! command -v op >/dev/null 2>&1; then
    printf 'op is required. Install 1Password CLI with: brew install --cask 1password-cli\n' >&2
    exit 1
  fi

  if ! reference="$(proteus_github_reference)"; then
    printf 'GitHub credential source is not configured. Run ./configure first.\n' >&2
    exit 1
  fi
  readonly reference

  if [[ -z "$reference" ]]; then
    printf 'GitHub credential source is not configured. Run ./configure first.\n' >&2
    exit 1
  fi
elif [[ ! -t 0 || ! -t 1 ]]; then
  if [[ "$tool" == t3 ]]; then
    printf 'T3 Enrollment requires an interactive terminal for input and output.\n' >&2
  elif [[ "$tool" == salesforce ]]; then
    printf 'Salesforce Credential Enrollment requires an interactive terminal for input and output.\n' >&2
  else
    printf 'Claude Code Credential Enrollment requires an interactive terminal for input and output.\n' >&2
  fi
  exit 1
fi

if ! command -v limactl >/dev/null 2>&1; then
  printf 'limactl is required. Install it with: brew install lima\n' >&2
  exit 1
fi

if ! instance_status="$(limactl list --tty=false --format='{{.Status}}' "$instance" 2>/dev/null)" ||
  [[ -z "$instance_status" ]]; then
  printf "Lima instance '%s' does not exist.\n" "$instance" >&2
  exit 1
fi

if [[ "$instance_status" != Running ]]; then
  printf "Lima instance '%s' is not running (status: %s).\n" "$instance" "${instance_status:-unknown}" >&2
  exit 1
fi

if [[ "$tool" == t3 ]]; then
  # HOME must expand in the guest. The helper owns guest setup and verification.
  # shellcheck disable=SC2016
  if ! limactl shell --tty=false --start=false "$instance" sh -c \
    'test -x "$HOME/.local/bin/t3" && test -x "$HOME/.local/bin/mise" && test -x "$HOME/.local/bin/proteus-enroll-t3" && command -v python3 >/dev/null'; then
    printf "Lima instance '%s' has not been provisioned with T3 Enrollment. Run ./provision first.\n" "$instance" >&2
    exit 1
  fi

  # shellcheck disable=SC2016
  if ! limactl shell --tty=true --start=false "$instance" sh -c \
    'exec "$HOME/.local/bin/proteus-enroll-t3"'; then
    printf "T3 Enrollment is incomplete for Lima instance '%s'. Completed steps were preserved.\n" "$instance" >&2
    exit 1
  fi

  printf "Enrolled T3 in Lima instance '%s'. Authorization is saved and the background service is running; connect from another device to verify remote access.\n" "$instance"
  exit 0
fi

if [[ "$tool" == salesforce ]]; then
  readonly salesforce_login_url='https://login.salesforce.com'

  # HOME must expand in the guest. The helper owns login and verification.
  # shellcheck disable=SC2016
  if ! limactl shell --tty=false --start=false "$instance" sh -c \
    'test -x "$HOME/.local/bin/sf" && test -x "$HOME/.local/share/proteus/salesforce-cli/sf" && test -x "$HOME/.local/share/proteus/salesforce-cli/node" && test -x "$HOME/.local/bin/proteus-enroll-salesforce" && test -x "$HOME/.local/bin/proteus-capture-browser-url" && command -v python3 >/dev/null' >/dev/null 2>&1; then
    printf "Lima instance '%s' has not been provisioned with Salesforce CLI. Run ./provision first.\n" "$instance" >&2
    exit 1
  fi

  # shellcheck disable=SC2016
  if ! limactl shell --tty=true --start=false "$instance" sh -c \
    'exec "$HOME/.local/bin/proteus-enroll-salesforce" "$1"' sh "$salesforce_login_url"; then
    printf "Salesforce Credential Enrollment failed for Lima instance '%s'.\n" "$instance" >&2
    exit 1
  fi

  printf "Enrolled the Dev Hub User in Lima instance '%s'. Salesforce CLI uses it as the default Dev Hub with the alias devhub.\n" "$instance"
  exit 0
fi

if [[ "$tool" == claude ]]; then
  # HOME must expand in the guest. mise supplies the managed Node runtime.
  # shellcheck disable=SC2016
  if ! limactl shell --tty=false --start=false "$instance" sh -c \
    'test -x "$HOME/.local/bin/claude" && test -x "$HOME/.local/bin/mise"' >/dev/null 2>&1; then
    printf "Lima instance '%s' has not been provisioned with Claude Code. Run ./provision first.\n" "$instance" >&2
    exit 1
  fi

  printf 'Open the login URL in your macOS browser, authorize access, and paste the returned code into this terminal if prompted.\n'

  # shellcheck disable=SC2016
  if ! limactl shell --tty=true --start=false "$instance" sh -c \
    'exec "$HOME/.local/bin/mise" exec -- "$HOME/.local/bin/claude" auth login'; then
    printf "Claude Code Credential Enrollment failed for Lima instance '%s'.\n" "$instance" >&2
    exit 1
  fi

  # shellcheck disable=SC2016
  if ! limactl shell --tty=false --start=false "$instance" sh -c \
    'exec "$HOME/.local/bin/mise" exec -- "$HOME/.local/bin/claude" auth status' >/dev/null 2>&1; then
    printf "Claude Code could not confirm authentication in Lima instance '%s'.\n" "$instance" >&2
    exit 1
  fi

  printf "Enrolled Claude Code in Lima instance '%s'.\n" "$instance"
  exit 0
fi

# HOME must expand in the guest.
# shellcheck disable=SC2016
if ! limactl shell --tty=false "$instance" sh -c \
  'test -x "$HOME/.local/bin/proteus-enroll-github" && test -x "$HOME/.local/bin/proteus-git-credential-github" && test -x "$HOME/.local/bin/gh" && command -v gh >/dev/null' >/dev/null 2>&1; then
  printf "Lima instance '%s' has not been provisioned with GitHub Credential Enrollment. Run ./provision first.\n" "$instance" >&2
  exit 1
fi

# HOME must expand in the guest.
# shellcheck disable=SC2016
if ! op read "$reference" |
  limactl shell --tty=false "$instance" sh -c \
    'exec "$HOME/.local/bin/proteus-enroll-github"'; then
  printf "GitHub Credential Enrollment failed for Lima instance '%s'.\n" "$instance" >&2
  exit 1
fi

printf "Enrolled the GitHub credential in Lima instance '%s'. Git HTTPS and GitHub CLI access are ready.\n" "$instance"
