#!/usr/bin/env bash
set -euo pipefail

# Background services cannot use secret-tool, which Salesforce CLI otherwise
# selects whenever it is installed. Keep the guest's production-org
# credential out of usage data.
export SF_USE_GENERIC_UNIX_KEYCHAIN=true
export SF_DISABLE_TELEMETRY=true

export SF_AUTOUPDATE_DISABLE=true
export SF_DISABLE_AUTOUPDATE=true

# Use the archive's bundled runtime directly. Its shell entry point can redirect
# to a user-updated client or select a custom Node. Provisioning owns this client;
# child commands keep the caller's project PATH.
readonly cli_dir="$HOME/.local/share/proteus/salesforce-cli/current"
export SF_BINPATH="$HOME/.local/bin/sf"
exec "${cli_dir}/bin/node" --no-deprecation "${cli_dir}/bin/run.js" "$@"
