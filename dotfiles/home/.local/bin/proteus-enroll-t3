#!/usr/bin/env python3
"""Enroll the guest's T3 environment without taking over an existing server.

Completion verifies saved Connect configuration and systemd persistence.
The server runtime file is used only to protect existing servers before setup.
Status output and credentials are never printed.
"""

import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys


UNIT = "t3code.service"


class Incomplete(Exception):
    """An actionable enrollment failure, with completed steps left intact."""


def read_command(arguments):
    return subprocess.run(
        arguments, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30,
    )


class Enrollment:
    def __init__(self):
        self.home = Path.home()
        self.base = Path(os.environ.get("T3CODE_HOME", self.home / ".t3")).expanduser().resolve()
        self.state = self.base / "userdata"
        self.cli = [str(self.home / ".local/bin/t3")]

    def t3(self, *arguments, interactive=False):
        command = [*self.cli, *arguments, "--base-dir", str(self.base)]
        if interactive:
            return subprocess.run(command).returncode
        result = read_command(command)
        if result.returncode:
            raise Incomplete("Could not read T3 Connect state. Inspect `t3 connect status` in the guest.")
        try:
            value = json.loads(result.stdout)
            if not isinstance(value, dict):
                raise ValueError
            for name in ("desired", "authenticated", "linked"):
                if type(value.get(name)) is not bool:
                    raise ValueError
            return value
        except (ValueError, AttributeError):
            raise Incomplete("Unrecognized T3 Connect status. Check the installed T3 version.") from None

    def service(self):
        result = read_command([
            "systemctl", "--user", "show", UNIT,
            "--property=LoadState,ActiveState,UnitFileState,Environment",
        ])
        properties = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
        if properties.get("LoadState") == "not-found":
            # A unit written without daemon-reload is still an existing install.
            if (self.home / ".config/systemd/user" / UNIT).exists():
                raise Incomplete("The T3 service needs repair. Inspect `t3 service status`, then run `t3 service install` explicitly.")
            return None
        if result.returncode or properties.get("LoadState") != "loaded":
            raise Incomplete("Could not inspect the T3 user service. Check `systemctl --user status t3code.service`.")
        return properties

    def running_server(self):
        path = self.state / "server-runtime.json"
        if not path.exists():
            return None
        try:
            value = json.loads(path.read_text())
            if not isinstance(value, dict) or type(value.get("version")) is not int or value["version"] != 1:
                raise ValueError
            pid = value["pid"]
            if type(pid) is not int or pid <= 1:
                raise ValueError
            if type(value.get("serviceManaged")) is not bool:
                raise ValueError
            os.kill(pid, 0)
            return value
        except ProcessLookupError:
            return None
        except (ValueError, KeyError, TypeError, PermissionError):
            raise Incomplete("Could not safely identify the existing T3 server. Inspect `t3 service status` before retrying.") from None

    def protect_server(self, service):
        server = self.running_server()
        if server and (server.get("serviceManaged") is not True or service is None):
            raise Incomplete("A foreground T3 server is running. Stop it explicitly when its work is finished, then retry enrollment.")
        return server

    def ensure_lingering(self):
        def linger():
            return read_command([
                "loginctl", "show-user", str(os.getuid()), "--property=Linger", "--value",
            ])

        result = linger()
        if result.returncode or result.stdout.strip() not in ("yes", "no"):
            raise Incomplete("Could not inspect lingering. Check that systemd-logind is available in the guest.")
        if result.stdout.strip() == "no":
            result = read_command(["sudo", "-n", "loginctl", "enable-linger", str(os.getuid())])
            verified = linger()
            if result.returncode or verified.returncode or verified.stdout.strip() != "yes":
                raise Incomplete('Could not enable lingering. Run `sudo loginctl enable-linger "$(id -un)"` in the guest, then retry.')

    def healthy_service(self, service):
        if not service or service.get("ActiveState") != "active" or service.get("UnitFileState") != "enabled":
            return False
        environment = dict(
            item.split("=", 1) for item in shlex.split(service.get("Environment", "")) if "=" in item
        )
        if environment.get("T3CODE_HOME") != str(self.base):
            raise Incomplete("The existing T3 service uses another data directory. Manage that service explicitly before enrolling this environment.")
        return True

    def run(self):
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise Incomplete("T3 Enrollment requires an interactive terminal for input and output.")
        if os.getuid() == 0:
            raise Incomplete("Run T3 Enrollment as the normal guest user, not root.")
        for command in ("systemctl", "loginctl", "sudo"):
            if not shutil.which(command):
                raise Incomplete(f"{command} is required in the guest. Run Provisioning first.")
        if read_command(["systemctl", "--user", "show-environment"]).returncode:
            raise Incomplete("The systemd user manager is unavailable. Open a normal guest login session and retry.")

        service = self.service()
        self.ensure_lingering()
        status = self.t3("connect", "status", "--json")
        if service:
            if not self.healthy_service(service):
                raise Incomplete("The existing T3 service needs repair. Inspect `t3 service status`, then run `t3 service install` explicitly when ready.")
            # Link has no service offer, so it cannot update/restart an existing unit.
            if not all(status[name] for name in ("desired", "authenticated", "linked")):
                self.protect_server(service)
                if self.t3("connect", "link", "--headless", interactive=True):
                    raise Incomplete("T3 authorization or linking failed. Retry enrollment; completed steps were preserved.")
                status = self.t3("connect", "status", "--json")
        else:
            print("Open T3's browser URL on macOS, confirm the short code, and approve. Accept relay-client and background-service installation when offered.", flush=True)
            # Recheck before onboarding, which can otherwise replace an existing unit.
            if self.service() is not None:
                raise Incomplete("A T3 service appeared during enrollment. Retry to verify it without replacing it.")
            self.protect_server(None)
            if self.t3("connect", "--headless", interactive=True):
                raise Incomplete("T3 setup failed. Retry enrollment; completed steps were preserved.")
            status = self.t3("connect", "status", "--json")

        if not all(status[name] for name in ("desired", "authenticated", "linked")):
            raise Incomplete("T3 authorization or environment linking is incomplete. Retry enrollment and complete T3's prompts.")
        if not self.healthy_service(self.service()):
            raise Incomplete("T3 service installation is incomplete. Inspect `t3 service status`, then retry enrollment or run `t3 service install` explicitly.")


def main():
    try:
        Enrollment().run()
    except (Incomplete, OSError, subprocess.TimeoutExpired, ValueError) as error:
        # Unexpected OS/subprocess details may include captured status output.
        message = str(error) if isinstance(error, Incomplete) else "Could not verify T3 setup. Inspect `t3 service status` and retry."
        print(message, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("T3 Enrollment interrupted. Completed steps were preserved.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
