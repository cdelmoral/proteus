#!/usr/bin/env bash
set -euo pipefail

# Git invokes helpers directly, including from services without shell startup.
# Only the credential lookup subprocess receives the current enrolled token.
if [[ "${1:-}" != get ]]; then
  exit 0
fi

# shellcheck source=dotfiles/home/.local/lib/proteus/credentials.sh
source "$HOME/.local/lib/proteus/credentials.sh"
token_file="$(proteus_github_token_file)"
if [[ ! -r "$token_file" ]]; then
  exit 0
fi

GH_TOKEN="$(<"$token_file")"
if [[ -z "$GH_TOKEN" ]]; then
  exit 0
fi
export GH_TOKEN
exec gh auth git-credential "$@"
