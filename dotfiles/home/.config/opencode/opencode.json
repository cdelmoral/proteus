{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "openai/gpt-5.6-sol",
  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "*": "ask",
          "find *": "allow",
          "head *": "allow",
          "ls *": "allow",
          "tail *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "git log *": "allow",
          "git diff *": "allow",
          "git show *": "allow",
          "git status *": "allow"
        }
      }
    }
  }
}
