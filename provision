#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
readonly script_dir
readonly playbook="${script_dir}/provisioning/playbook.yml"

usage() {
  printf 'Usage: %s [instance-name]\n' "${0##*/}" >&2
}

if [[ $# -gt 1 || ( $# -eq 1 && ( -z "$1" || "$1" == -* ) ) ]]; then
  usage
  exit 2
fi
readonly instance="${1:-proteus}"

if ! command -v ansible-playbook >/dev/null 2>&1; then
  printf 'ansible-playbook is required. Install it with: brew install ansible\n' >&2
  exit 1
fi

if ! command -v limactl >/dev/null 2>&1; then
  printf 'limactl is required. Install it with: brew install lima\n' >&2
  exit 1
fi

if ! instance_info="$(limactl list --tty=false --format='{{.Status}}|{{.Hostname}}|{{.SSHConfigFile}}' "$instance" 2>/dev/null)" ||
  [[ -z "$instance_info" ]]; then
  printf "Lima instance '%s' does not exist.\n" "$instance" >&2
  exit 1
fi

IFS='|' read -r status hostname ssh_config <<<"$instance_info"

if [[ "$status" != "Running" ]]; then
  printf "Lima instance '%s' is not running (status: %s).\n" "$instance" "${status:-unknown}" >&2
  exit 1
fi

if [[ -z "$hostname" ]]; then
  printf "Lima did not report an SSH hostname for instance '%s'.\n" "$instance" >&2
  exit 1
fi

if [[ -z "$ssh_config" || ! -f "$ssh_config" || ! -r "$ssh_config" ]]; then
  printf "Lima SSH configuration is not readable: %s\n" "${ssh_config:-<empty>}" >&2
  exit 1
fi

ansible_arguments=(
  --inventory
  "${hostname},"
  "--ssh-common-args=-F ${ssh_config}"
)
exec ansible-playbook "${ansible_arguments[@]}" "$playbook"
